+void NewOptionsDialog::MouseMove(int theX, int theY)
+{
+	Dialog::MouseMove(theX, theY);
+	mAboutHover = mAboutLinkRect.Contains(theX, theY);
+
+	mAboutLinkHover = -1;
+	if (mAboutPanelOpen)
+	{
+		for (int i = 0; i < 2; i++)
+		{
+			if (AboutLinkRect(i).Contains(theX, theY))
+				mAboutLinkHover = i;
+		}
+	}
+}
+
+void NewOptionsDialog::MouseDown(int theX, int theY, int theClickCount)
+{
+	// Panel Tentang sedang terbuka: cek tombol tautan dulu, selain itu klik
+	// di mana pun menutup panel. Klik tidak diteruskan ke checkbox di
+	// belakangnya.
+	if (mAboutPanelOpen)
+	{
+		for (int i = 0; i < 2; i++)
+		{
+			if (AboutLinkRect(i).Contains(theX, theY))
+			{
+				OpenSupportLink(i);
+				mApp->PlaySample(SOUND_BUTTONCLICK);
+				return;
+			}
+		}
+
+		SetAboutPanelOpen(false);
+		mApp->PlaySample(SOUND_BUTTONCLICK);
+		return;
+	}
+
+	if (mAboutLinkRect.Contains(theX, theY))
+	{
+		SetAboutPanelOpen(true);
+		mApp->PlaySample(SOUND_BUTTONCLICK);
+		return;
+	}
+
+	Dialog::MouseDown(theX, theY, theClickCount);
+}
+
+void NewOptionsDialog::MouseUp(int theX, int theY, int theClickCount)
+{
+	if (mAboutPanelOpen)
+		return;
+
+	if (mAboutLinkRect.Contains(theX, theY))
+		return;
+
+	Dialog::MouseUp(theX, theY, theClickCount);
+}
