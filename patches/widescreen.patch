+	g->SetColor(Sexy::Color(34, 36, 56));
+	g->FillRect(kAboutPanelX, kAboutPanelY, kAboutPanelW, kAboutPanelH);
+
+	g->SetColor(Sexy::Color(92, 96, 136));
+	g->DrawRect(kAboutPanelX, kAboutPanelY, kAboutPanelW, kAboutPanelH);
+	g->SetColor(Sexy::Color(58, 62, 92));
+	g->DrawRect(kAboutPanelX + 3, kAboutPanelY + 3, kAboutPanelW - 6, kAboutPanelH - 6);
+
+	if (theFontScale != 1.0f)
+		g->SetScale(1.0f, 1.0f, 0.0f, 0.0f);
+
+	// Semua koordinat Y di bawah ini RELATIF terhadap puncak panel.
+	const int aMid = kAboutPanelX + kAboutPanelW / 2;
+	const int aPad = kAboutPanelX + 24;
+
+	PvzpDrawString(g, "Plants vs. Zombies", aMid, kAboutPanelY + 18, FONT_DWARVENTODCRAFT18, Sexy::Color(255, 232, 130), DrawStringJustification::DS_ALIGN_CENTER);
+	PvzpDrawString(g, "Linux Native", aMid, kAboutPanelY + 40, FONT_DWARVENTODCRAFT15, Sexy::Color(198, 204, 226), DrawStringJustification::DS_ALIGN_CENTER);
+
+	PvzpDrawString(g, "Dibuat oleh", aMid, kAboutPanelY + 72, FONT_DWARVENTODCRAFT12, Sexy::Color(158, 164, 190), DrawStringJustification::DS_ALIGN_CENTER);
+	PvzpDrawString(g, "Katon Bagaskoro", aMid, kAboutPanelY + 92, FONT_DWARVENTODCRAFT18, Sexy::Color(240, 242, 250), DrawStringJustification::DS_ALIGN_CENTER);
+
+	g->SetColor(Sexy::Color(70, 74, 108));
+	g->FillRect(aPad, kAboutPanelY + 108, kAboutPanelW - 48, 1);
+
+	PvzpDrawString(g, "Dukung proyek ini", aMid, kAboutPanelY + 124, FONT_DWARVENTODCRAFT12, Sexy::Color(158, 164, 190), DrawStringJustification::DS_ALIGN_CENTER);
+
+	const char* aLabels[2] = { "Saweria", "Ko-fi" };
+	for (int i = 0; i < 2; i++)
+	{
+		Sexy::Rect aRect = AboutLinkRect(i);
+		const bool aHover = (mAboutLinkHover == i);
+		g->SetColor(aHover ? Sexy::Color(52, 88, 60) : Sexy::Color(44, 48, 74));
+		g->FillRect(aRect.mX, aRect.mY, aRect.mWidth, aRect.mHeight);
+		g->SetColor(aHover ? Sexy::Color(140, 220, 140) : Sexy::Color(88, 124, 88));
+		g->DrawRect(aRect.mX, aRect.mY, aRect.mWidth, aRect.mHeight);
+		PvzpDrawString(
+			g, aLabels[i],
+			aRect.mX + aRect.mWidth / 2, aRect.mY + 16,
+			FONT_DWARVENTODCRAFT15,
+			aHover ? Sexy::Color(200, 255, 190) : Sexy::Color(150, 210, 130),
+			DrawStringJustification::DS_ALIGN_CENTER);
+	}
+
+	PvzpDrawString(g, "Engine PvZ-Portable (LGPL-3.0)", aMid, kAboutPanelY + 216, FONT_DWARVENTODCRAFT12, Sexy::Color(140, 146, 172), DrawStringJustification::DS_ALIGN_CENTER);
+	PvzpDrawString(g, "PvZ (c) EA - proyek tidak resmi", aMid, kAboutPanelY + 232, FONT_DWARVENTODCRAFT12, Sexy::Color(120, 126, 152), DrawStringJustification::DS_ALIGN_CENTER);
+
+	if (theFontScale != 1.0f)
+		g->SetScale(theFontScale, theFontScale, 0.0f, 0.0f);
+
+	g->SetColor(Sexy::Color::White);
+}
