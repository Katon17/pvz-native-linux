+void NewOptionsDialog::OpenSupportLink(int theIndex)
+{
+	const char* aUrl = theIndex == 0
+		? "https://saweria.co/Kabako"
+		: "https://ko-fi.com/katonbagaskoro";
+
+	// SexyAppBase::OpenURL cuma stub di port ini (tidak pernah memanggil
+	// xdg-open), jadi browser dibuka lewat SDL yang sudah menangani
+	// xdg-open / ShellExecute sesuai platform.
+	if (!SDL_OpenURL(aUrl))
+		PvzpLogLn("Gagal membuka tautan {}: {}", aUrl, SDL_GetError());
+}
