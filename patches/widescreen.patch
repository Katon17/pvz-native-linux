+void NewOptionsDialog::SetAboutPanelOpen(bool theOpen)
+{
+	mAboutPanelOpen = theOpen;
+	if (!theOpen)
+		mAboutLinkHover = -1;
+
+	// Kontrol adalah widget anak, digambar SETELAH Draw() induk, jadi panel
+	// Tentang akan tertembus checkbox/slider kalau dibiarkan tampil.
+	const bool aShow = !theOpen;
+	mMusicVolumeSlider->SetVisible(aShow);
+	mSfxVolumeSlider->SetVisible(aShow);
+	mHardwareAccelerationCheckbox->SetVisible(aShow);
+	mFullscreenCheckbox->SetVisible(aShow);
+	mWidescreenCheckbox->SetVisible(aShow);
+}
+
+Sexy::Rect NewOptionsDialog::AboutLinkRect(int theIndex) const
